<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Notes for Addie 💙</title>
  <style>
    :root{
      --bg1:#e6f0ff;
      --bg2:#cce0ff;
      --card:#ffffff;
      --accent:#3399ff;
      --muted:#4a6fa5;
      --shadow:0 10px 30px rgba(0,0,0,0.12);
    }
    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial;}
    body{
      background: radial-gradient(1200px 600px at 10% 10%, rgba(51,153,255,0.06), transparent),
                  linear-gradient(135deg,var(--bg1),var(--bg2));
      display:flex;align-items:center;justify-content:center;padding:20px;
    }
    .container{max-width:760px;width:100%;}
    .card{
      background:var(--card);border-radius:20px;padding:26px;box-shadow:var(--shadow);
      display:flex;flex-direction:column;gap:14px;align-items:stretch;overflow:hidden;
    }
    .title{font-size:24px;color:var(--accent);font-weight:800;text-align:center}
    .subtitle{font-size:14px;color:var(--muted);text-align:center;margin-top:-6px}
    .countdown{font-size:13px;color:var(--muted);text-align:center}
    .note-card{background:linear-gradient(180deg, rgba(240,248,255,0.95), #fff);border-radius:14px;padding:20px;min-height:220px;display:flex;flex-direction:column;gap:10px;align-items:flex-start;box-shadow:0 6px 18px rgba(0,0,0,0.04)}
    .note-text{font-size:17px;color:#16324f;line-height:1.55;white-space:pre-wrap}
    .meta{display:flex;gap:10px;align-items:center;width:100%;justify-content:space-between}
    .date{color:var(--muted);font-size:13px}
    .controls{display:flex;gap:10px}
    .btn{background:linear-gradient(90deg,#66b2ff,#3399ff);border:none;color:white;padding:8px 14px;border-radius:10px;cursor:pointer;font-weight:700;transition:all 0.16s}
    .btn:hover{transform:translateY(-2px)}
    .small{padding:6px 10px;border-radius:8px;font-weight:600}
    .nickname{font-weight:900;color:var(--accent)}
    .footer{margin-top:6px;color:var(--muted);font-size:13px;text-align:center}
    /* hearts */
    .hearts {position:fixed;left:0;top:0;pointer-events:none;overflow:hidden;width:100%;height:100%;z-index:30;}
    .heart {position:absolute;font-size:22px;opacity:0;transform:translateY(0);animation:floatUp 4s linear forwards;}
    @keyframes floatUp {0%{opacity:1; transform: translateY(25vh) scale(.8);}100%{opacity:0; transform: translateY(-30vh) scale(1.25);}}
    /* fireworks canvas */
    #fireworks {position:fixed;left:0;top:0;width:100%;height:100%;pointer-events:none;z-index:40;display:none;}
    /* mobile adjustments */
    @media(max-width:720px){ .note-card{padding:16px} .title{font-size:20px} .note-text{font-size:16px} }
  </style>
</head>
<body>
  <div class="hearts" id="hearts"></div>
  <canvas id="fireworks"></canvas>

  <div class="container">
    <div class="card">
      <div class="title">Notes for Addie 💙</div>
      <div class="subtitle">Open here every day until <strong>July 13, 2026</strong> for a new love note — one unique note per day.</div>
      <div class="countdown" id="countdown">Loading countdown…</div>

      <div class="note-card" id="noteCard">
        <div style="display:flex;align-items:center;width:100%;gap:12px;">
          <div style="display:flex;flex-direction:column;">
            <div style="font-weight:800;font-size:18px;color:var(--accent)">For Addie — love note of the day</div>
            <div class="date" id="noteDate">Loading...</div>
          </div>
          <div style="margin-left:auto" class="controls">
            <button class="btn small" id="prevBtn">◀ Prev</button>
            <button class="btn small" id="nextBtn">Next ▶</button>
          </div>
        </div>

        <div class="note-text" id="noteText">Preparing your note...</div>
        <div class="footer" id="footer">Made with love by Chase ❤️</div>
      </div>

      <div style="display:flex;gap:10px;justify-content:center;margin-top:6px;">
        <button class="btn" id="copyBtn">Copy note</button>
        <button class="btn" id="downloadBtn">Download as PNG</button>
      </div>
    </div>
  </div>

<script>
/* =========================
   Configuration & Dates
   ========================= */
const START_DATE = new Date('2025-09-14T00:00:00'); // start showing notes from this date
const ANNIV_DATE_STR = '2026-07-13';
const ANNIV_DATE = new Date('2026-07-13T00:00:00');
const END_DATE = new Date('2026-07-13T23:59:59');
const DAYS_TO_GENERATE = 365;
const STORAGE_KEY_INDEX = 'addie_notes_last_index';

/* =========================
   Deterministic RNG (Mulberry32)
   so generation is repeatable across visits
   ========================= */
function mulberry32(a){
  return function(){
    a |= 0; a = a + 0x6D2B79F5 | 0;
    let t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  }
}

/* =========================
   Phrase pools (many entries to ensure variety)
   No mention of freckles; removed earlier references.
   ========================= */
const POOLS = {
  nicknames: [
    "Koala","Addie bear","Babe","Bby","Ml","Sweetheart","Pumpkin",
    "My little star","My precious little girl","My sweet girl","My little bundle of joy","My safe space"
  ],
  looks: [
    "your blue eyes still stop me in my tracks — there’s a whole ocean of kindness in them.",
    "your warm brown hair frames your face so beautifully; I fall for you all over again.",
    "the way you smile lights up even my cloudiest days.",
    "there’s a sparkle in your eyes when you laugh that I keep replaying.",
    "your gentle face calms my rushing heart every time I picture you."
  ],
  personality: [
    "you’re brave and fearless when you need to be, and soft and comforting when someone needs you.",
    "your kindness spills out to everyone around you and it makes me proud.",
    "you have a hilarious, perfectly-timed sense of humor that makes me grin like a fool.",
    "you think deeply, and I love how thoughtfully you see the world.",
    "your courage and compassion push me to be better each day."
  ],
  relationship: [
    "even miles apart, our love feels near — a steady, warm presence.",
    "I daydream about our future: small mornings, big adventures, and secret jokes we’ll keep forever.",
    "you’re my chosen one, the person I want to plan forever with.",
    "I imagine our wedding day like a warm film I can’t wait to watch with you.",
    "you make me want to grow, to learn, and to cherish everything we build together."
  ],
  memories: [
    "I replay our sweetest moments in my head — your laugh on the first call, the little things you said.",
    "I keep our messages like treasures — every voice note, every playful text is a tiny home for me.",
    "some nights I look back at our first week and smile at how perfect your voice sounded over the phone."
  ],
  future: [
    "I can’t wait for cozy breakfasts together, those small ordinary moments I dream of.",
    "we’ll take trips and make silly traditions — I’m excited for every ordinary Sunday with you.",
    "one day we’ll look back and feel proud of how we grew together through distance and time."
  ],
  encouragement: [
    "on hard days remember you are loved more than you know and stronger than your worries.",
    "if doubt creeps in, come back to this: I believe in you with every beat of my heart.",
    "you are enough exactly as you are — soft, brilliant, and deeply loved."
  ],
  romantic: [
    "being in love with you feels like a poem that writes itself into my chest.",
    "I want to kiss you under a sky full of stars and promise you forever.",
    "your love is my favorite song, and I never want it to stop playing."
  ],
  fun: [
    "remember that time we laughed so hard we cried? You’re my favorite comedy show.",
    "with you, even a grocery run would feel like a tiny adventure.",
    "I adore our goofy moments — you make ordinary things bright and silly."
  ],
  songs: [
    "You are my sunshine, you make me whole inside — a gentle song for when you miss me.",
    "I can’t help falling in love with you — that’s what my heart keeps humming.",
    "You’re the chorus I sing to myself when I wake up smiling at the thought of you."
  ],
  poems: [
    "A short poem: Two hearts, one quiet map — each day we trace the lines back home to each other.",
    "A little verse: Your name, a bell; my answer, an echo — forever returning to you.",
    "Tiny poem: soft light, warm hands, your laugh — my favorite place to be."
  ],
  verses: [
    "\"Love is patient, love is kind...\" — 1 Corinthians 13:4",
    "\"I am my beloved’s and my beloved is mine.\" — Song of Solomon 6:3",
    "\"The Lord has done great things for us; we are filled with joy.\" — Psalm 126:3"
  ],
  closers: [
    "All my love, always.","Forever yours.","With every beat of my heart.","Yours and only yours.","Always & forever."
  ]
};

/* =========================
   Build unique notes (365) at runtime deterministically.
   Guarantee uniqueness by checking previously-built notes and rolling until unique.
   This keeps the file lighter and consistent across visits.
   ========================= */
function buildAllNotes(){
  const notes = [];
  const used = new Set();
  // baseSeed gives consistent generation
  const baseSeed = 987654;
  for(let day=0; day < DAYS_TO_GENERATE; day++){
    let attempt = 0;
    let note = '';
    while(true){
      const rng = mulberry32(baseSeed + day*101 + attempt*17);
      // pick nickname (bolded via span)
      const nick = POOLS.nicknames[Math.floor(rng()*POOLS.nicknames.length)];
      // Build structure: opener + 2-4 sentences, sometimes include song/poem/verse
      const parts = [];
      parts.push(`<span class="nickname">${nick}</span>, ${randomPick(rng, POOLS.looks)}`);
      // choose a pattern
      const pattern = Math.floor(rng()*6);
      if(pattern === 0){
        // personality + relationship + closer
        parts.push(capFirst(randomPick(rng, POOLS.personality)) + ' ' + randomPick(rng, POOLS.relationship));
        if(rng() < 0.35) parts.push(randomPick(rng, POOLS.memories));
        if(rng() < 0.25) parts.push(randomPick(rng, POOLS.verses));
      } else if(pattern === 1){
        // romantic + future + closer
        parts.push(randomPick(rng, POOLS.romantic));
        parts.push(randomPick(rng, POOLS.future) + ' ' + randomPick(rng, POOLS.encouragement));
      } else if(pattern === 2){
        // fun + song + closer
        parts.push(randomPick(rng, POOLS.fun));
        if(rng() < 0.45) parts.push(randomPick(rng, POOLS.songs));
        if(rng() < 0.2) parts.push(randomPick(rng, POOLS.verses));
      } else if(pattern === 3){
        // poem + relationship + closer
        parts.push(randomPick(rng, POOLS.poems));
        parts.push(randomPick(rng, POOLS.relationship));
      } else if(pattern === 4){
        // encouragement + memory + romantic
        parts.push(randomPick(rng, POOLS.encouragement));
        parts.push(randomPick(rng, POOLS.memories));
        if(rng() < 0.3) parts.push(randomPick(rng, POOLS.romantic));
      } else {
        // mixed
        if(rng() < 0.5) parts.push(randomPick(rng, POOLS.personality));
        if(rng() < 0.5) parts.push(randomPick(rng, POOLS.future));
        if(rng() < 0.35) parts.push(randomPick(rng, POOLS.songs));
        if(rng() < 0.15) parts.push(randomPick(rng, POOLS.verses));
      }
      parts.push(randomPick(rng, POOLS.closers));
      note = parts.join(' ');
      // normalize for duplication check
      const dd = note.replace(/<[^>]*>/g,'').trim().toLowerCase();
      if(!used.has(dd)){
        used.add(dd);
        notes.push(note);
        break;
      }
      attempt++;
      // fallback: if too many attempts, slightly alter by adding day number text
      if(attempt > 15){
        note = note + ` (day ${day+1})`;
        used.add(note.toLowerCase());
        notes.push(note);
        break;
      }
    }
  }
  return notes;
}

function randomPick(rng, arr){
  return arr[Math.floor(rng()*arr.length)];
}
function capFirst(s){ if(!s) return s; return s[0].toUpperCase()+s.slice(1); }

/* =========================
   UI & behavior
   ========================= */
const notes = buildAllNotes(); // deterministic unique set of 365 notes
const noteTextEl = document.getElementById('noteText');
const noteDateEl = document.getElementById('noteDate');
const prevBtn = document.getElementById('prevBtn');
const nextBtn = document.getElementById('nextBtn');
const copyBtn = document.getElementById('copyBtn');
const downloadBtn = document.getElementById('downloadBtn');
const countdownEl = document.getElementById('countdown');

function getDayIndex(forDate = new Date()){
  const d = new Date(forDate.getFullYear(), forDate.getMonth(), forDate.getDate());
  const s = new Date(START_DATE.getFullYear(), START_DATE.getMonth(), START_DATE.getDate());
  return Math.floor((d - s) / (1000*60*60*24));
}

// compute allowed index (today relative to START_DATE, clamp 0..DAYS_TO_GENERATE-1)
function todayIndex(){
  let idx = getDayIndex();
  if(idx < 0) idx = 0;
  if(idx >= DAYS_TO_GENERATE) idx = DAYS_TO_GENERATE - 1;
  return idx;
}

// load saved index but never allow future jump
let saved = parseInt(localStorage.getItem(STORAGE_KEY_INDEX), 10);
if(isNaN(saved)) saved = null;
let current = (saved !== null && saved <= todayIndex()) ? saved : todayIndex();

function showNote(index, save=true){
  // clamp so cannot view future notes
  const t = todayIndex();
  if(index > t) index = t;
  if(index < 0) index = 0;
  // special anniversary
  const date = new Date(START_DATE.getTime() + index*24*60*60*1000);
  const dateISO = date.toISOString().slice(0,10);
  const displayDate = date.toLocaleDateString(undefined, { weekday:'long', year:'numeric', month:'long', day:'numeric' });
  noteDateEl.textContent = displayDate;
  if(dateISO === ANNIV_DATE_STR){
    triggerAnniversaryAnimation();
    noteTextEl.innerHTML = `💛 Happy Anniversary, my love. Today we celebrate everything we've built — every laugh, every late-night call, every promise. I love you beyond words, and I can't wait to spend the rest of my life showing you how chosen you are.`;
  } else {
    noteTextEl.innerHTML = notes[index];
    spawnHearts();
  }
  current = index;
  if(save) localStorage.setItem(STORAGE_KEY_INDEX, String(current));
}

// navigation: prev allowed any past note, next only up to today
prevBtn.addEventListener('click', ()=>{ if(current > 0) showNote(current - 1); });
nextBtn.addEventListener('click', ()=>{ if(current < todayIndex()) showNote(current + 1); });

// keyboard support but still respect no-future rule
document.addEventListener('keydown', (e)=>{ if(e.key === 'ArrowLeft') prevBtn.click(); if(e.key === 'ArrowRight') nextBtn.click(); });

// copy & download
copyBtn.addEventListener('click', ()=> {
  navigator.clipboard.writeText(stripTags(noteTextEl.innerText)).then(()=>{
    copyBtn.textContent = 'Copied!';
    setTimeout(()=>copyBtn.textContent = 'Copy note', 1500);
  });
});
downloadBtn.addEventListener('click', ()=> downloadPNG());

// strip tags helper
function stripTags(s){ return s.replace(/<[^>]*>/g,''); }

/* =========================
   Hearts animation spawn
   ========================= */
function spawnHearts(){
  const container = document.getElementById('hearts');
  container.innerHTML = '';
  for(let i=0;i<12;i++){
    const el = document.createElement('div');
    el.className = 'heart';
    el.innerText = ['❤️','💙','💛'][Math.floor(Math.random()*3)];
    el.style.left = Math.random() * 100 + 'vw';
    el.style.top = (60 + Math.random()*30) + 'vh';
    el.style.fontSize = (14 + Math.random()*28) + 'px';
    el.style.animationDuration = (3 + Math.random()*3) + 's';
    container.appendChild(el);
    // remove after animation to clean DOM
    setTimeout(()=>{ try{ el.remove(); }catch(e){} }, 5000);
  }
}

/* =========================
   Anniversary fireworks + golden hearts
   ========================= */
const fwCanvas = document.getElementById('fireworks');
const fwCtx = fwCanvas.getContext?.('2d');
function resizeFW(){ fwCanvas.width = window.innerWidth; fwCanvas.height = window.innerHeight; }
window.addEventListener('resize', resizeFW); resizeFW();

function triggerAnniversaryAnimation(){
  // show canvas temporarily
  fwCanvas.style.display = 'block';
  const particles = [];
  function randomColor(){ return `hsl(${Math.floor(Math.random()*360)},90%,60%)`; }
  function emit(){
    const cx = Math.random()*fwCanvas.width;
    const cy = Math.random()*fwCanvas.height*0.6;
    const count = 40;
    for(let i=0;i<count;i++){
      particles.push({x:cx,y:cy,vx:(Math.random()-0.5)*6,vy:(Math.random()-0.9)*6,life:60,color:randomColor()});
    }
  }
  const emitInt = setInterval(emit, 400);
  const anim = setInterval(()=> {
    fwCtx.fillStyle = 'rgba(0,0,0,0.08)';
    fwCtx.fillRect(0,0,fwCanvas.width,fwCanvas.height);
    for(let i=particles.length-1;i>=0;i--){
      const p = particles[i];
      p.x += p.vx; p.y += p.vy; p.vy += 0.08; p.life--;
      fwCtx.fillStyle = p.color;
      fwCtx.fillRect(p.x, p.y, 2, 2);
      if(p.life <= 0) particles.splice(i,1);
    }
  }, 16);
  // golden hearts overlay
  spawnGoldenHearts();
  setTimeout(()=>{ clearInterval(emitInt); clearInterval(anim); fwCtx.clearRect(0,0,fwCanvas.width,fwCanvas.height); fwCanvas.style.display = 'none'; }, 8000);
}
function spawnGoldenHearts(){
  const container = document.getElementById('hearts');
  for(let i=0;i<16;i++){
    const el = document.createElement('div');
    el.className = 'heart';
    el.innerText = '💛';
    el.style.left = (10 + Math.random()*80)+'vw';
    el.style.top = (20 + Math.random()*60)+'vh';
    el.style.fontSize = (18 + Math.random()*30)+'px';
    el.style.animationDuration = (3 + Math.random()*4)+'s';
    container.appendChild(el);
    setTimeout(()=>{ try{ el.remove(); }catch(e){} }, 7000);
  }
}

/* =========================
   Countdown timer
   ========================= */
function updateCountdown(){
  const now = new Date();
  const diffMs = ANNIV_DATE - now;
  if(diffMs <= 0){
    countdownEl.textContent = 'Happy Anniversary 💛';
  } else {
    const days = Math.ceil(diffMs / (1000*60*60*24));
    countdownEl.textContent = `${days} days until our anniversary 💕`;
  }
}
updateCountdown();
setInterval(updateCountdown, 1000*60*60); // hourly update

/* =========================
   PNG download (simple rendering of note)
   ========================= */
function downloadPNG(){
  const w = 1000, h = 700;
  const canvas = document.createElement('canvas');
  canvas.width = w; canvas.height = h;
  const ctx = canvas.getContext('2d');
  // background
  const grd = ctx.createLinearGradient(0,0,w,h);
  grd.addColorStop(0,'#e6f0ff'); grd.addColorStop(1,'#ffffff');
  ctx.fillStyle = grd; ctx.fillRect(0,0,w,h);
  // title
  ctx.font = '34px Arial'; ctx.fillStyle = '#3399ff';
  ctx.fillText('For Addie — love note of the day', 40, 70);
  // note text
  ctx.font = '20px Arial'; ctx.fillStyle = '#16324f';
  wrapTextCanvas(ctx, stripTags(noteTextEl.innerText), 40, 120, w-80, 28);
  // save
  const link = document.createElement('a');
  link.download = `Addie_note_${noteDateEl.innerText.replace(/\s+/g,'_')}.png`;
  link.href = canvas.toDataURL('image/png');
  link.click();
}
function wrapTextCanvas(ctx, text, x, y, maxWidth, lineHeight){
  const words = text.split(' ');
  let line = '';
  for(let n=0;n<words.length;n++){
    const testLine = line + words[n] + ' ';
    const metrics = ctx.measureText(testLine);
    const testWidth = metrics.width;
    if(testWidth > maxWidth && n > 0){
      ctx.fillText(line, x, y);
      line = words[n] + ' ';
      y += lineHeight;
    } else {
      line = testLine;
    }
  }
  ctx.fillText(line, x, y);
}

/* =========================
   Init: show current note and spawn hearts
   ========================= */
showNote(current);

// when tab visibility resumes, refresh today and clamp
document.addEventListener('visibilitychange', ()=> {
  if(!document.hidden){
    const t = todayIndex();
    // if saved index bigger than today (clock changed), clamp
    if(current > t) current = t;
    showNote(current, true);
  }
});

</script>
</body>
</html>
